rules_version = '2';

// F1 Finger Race — règles Firestore v2.
//
// Principes :
//  - lecture publique de tout ce qui s'affiche dans le jeu (classements, défis, bandeau live) ;
//  - écriture possible sans compte (les invités jouent aussi), mais chaque document créé doit
//    respecter un format strict : bornes de temps par circuit, cohérence temps/tracé, pseudo
//    court, champs obligatoires uniquement — un temps "impossible" est refusé par le serveur ;
//  - jamais de modification ni de suppression des courses enregistrées ;
//  - anciennes collections (races, record_events) figées en lecture seule ;
//  - App Check (à activer dans la console, voir A-FAIRE.txt) complète ces règles en refusant les
//    requêtes qui ne viennent pas du site lui-même.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isShortStr(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function validCid(c) {
      return c in ['bahrein', 'arabie_saoudite', 'australie', 'japon', 'monaco', 'canada', 'espagne',
                   'autriche', 'royaume_uni', 'hongrie', 'belgique', 'pays_bas', 'monza', 'azerbaidjan',
                   'singapour', 'etats_unis', 'mexique', 'bresil', 'las_vegas', 'emirats'];
    }
    function validDiff(d) { return d in ['debutant', 'intermediaire', 'difficile']; }
    function validDir(d) { return d in ['normal', 'inverse']; }
    function validLaps(l) { return l in [1, 3, 5, 10]; }
    // Temps brut minimal plausible pour UN tour (longueur du tracé en unités logiques / 600 u/s,
    // soit bien au-delà de ce qu'un doigt peut faire sans sortir de la piste).
    function minLapTime(cid) {
      return {
        'bahrein': 4.0, 'arabie_saoudite': 2.7, 'australie': 3.7, 'japon': 3.7, 'monaco': 3.3,
        'canada': 2.7, 'espagne': 4.8, 'autriche': 3.9, 'royaume_uni': 3.6, 'hongrie': 3.0,
        'belgique': 3.9, 'pays_bas': 3.6, 'monza': 3.3, 'azerbaidjan': 2.9, 'singapour': 3.7,
        'etats_unis': 3.4, 'mexique': 3.3, 'bresil': 4.6, 'las_vegas': 3.7, 'emirats': 4.3
      }[cid];
    }
    function validRunTiming(d) {
      return d.time is number && d.raw is number && d.n is int
        && d.raw >= minLapTime(d.cid) * d.laps
        && d.time >= d.raw && d.time <= 3600
        && d.pen is int && d.pen >= 0 && d.pen <= 500
        // ~11 échantillons/s de tracé pendant la course : un temps sans tracé cohérent est refusé
        && d.n >= d.raw * 6 && d.n <= 120000;
    }
    function validWeekId(w) { return w is string && w.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function validKey(k) { return k is string && k.size() >= 6 && k.size() <= 64; }
    function ownsKey(k) {
      // Si connecté, la clé doit être l'UID ; sinon n'importe quelle clé invité (préfixe "g").
      return (request.auth != null && k == request.auth.uid) || (request.auth == null && k.matches('^g[a-z0-9]+$'));
    }

    // ---------- Classement hebdomadaire (v2) ----------
    match /races_v2/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['uid', 'name', 'v', 'raw', 'n', 'key', 'cid', 'diff', 'dir', 'laps', 'time', 'pen', 'raceKey', 'weekId', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'v', 'raw', 'n', 'key', 'cid', 'diff', 'dir', 'laps', 'time', 'pen', 'raceKey', 'weekId', 'createdAt'])
        && request.resource.data.v == 2
        && isShortStr(request.resource.data.name, 18)
        && validCid(request.resource.data.cid) && validDiff(request.resource.data.diff)
        && validDir(request.resource.data.dir) && validLaps(request.resource.data.laps)
        && validRunTiming(request.resource.data)
        && request.resource.data.raceKey == request.resource.data.cid + '_' + request.resource.data.diff + '_' + request.resource.data.dir + '_' + string(request.resource.data.laps)
        && validWeekId(request.resource.data.weekId)
        && validKey(request.resource.data.key) && ownsKey(request.resource.data.key)
        && (request.resource.data.uid == null || request.resource.data.uid == request.auth.uid)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ---------- Bandeau live : records battus (v2) ----------
    match /record_events_v2/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['cid', 'diff', 'dir', 'laps', 'name', 'time', 'margin', 'weekId', 'createdAt'])
        && request.resource.data.keys().hasAll(['cid', 'diff', 'dir', 'laps', 'name', 'time', 'margin', 'weekId', 'createdAt'])
        && validCid(request.resource.data.cid) && validDiff(request.resource.data.diff)
        && validDir(request.resource.data.dir) && validLaps(request.resource.data.laps)
        && isShortStr(request.resource.data.name, 18)
        && request.resource.data.time is number && request.resource.data.time >= minLapTime(request.resource.data.cid) * request.resource.data.laps && request.resource.data.time <= 3600
        && request.resource.data.margin is number && request.resource.data.margin > 0 && request.resource.data.margin <= 3600
        && validWeekId(request.resource.data.weekId)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ---------- Défi du jour ----------
    match /daily/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['dayId', 'key', 'uid', 'name', 'cid', 'diff', 'dir', 'laps', 'time', 'pen', 'raw', 'n', 'v', 'createdAt'])
        && request.resource.data.keys().hasAll(['dayId', 'key', 'name', 'cid', 'diff', 'dir', 'laps', 'time', 'pen', 'raw', 'n', 'v', 'createdAt'])
        && request.resource.data.v == 2
        && validWeekId(request.resource.data.dayId)
        && isShortStr(request.resource.data.name, 18)
        && validCid(request.resource.data.cid) && validDiff(request.resource.data.diff)
        && validDir(request.resource.data.dir) && request.resource.data.laps == 1
        && validRunTiming(request.resource.data)
        && validKey(request.resource.data.key) && ownsKey(request.resource.data.key)
        && (request.resource.data.uid == null || request.resource.data.uid == request.auth.uid)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ---------- Records personnels liés au compte ----------
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- Défis (privés et publics) ----------
    function validDuelCreate(d) {
      return d.keys().hasOnly(['cid', 'diff', 'dir', 'laps', 'createdAt', 'runs'])
        && d.keys().hasAll(['cid', 'diff', 'dir', 'laps', 'createdAt', 'runs'])
        && validCid(d.cid) && validDiff(d.diff) && validDir(d.dir) && validLaps(d.laps)
        && d.createdAt == request.time
        && d.runs is map && d.runs.size() <= 1;
    }
    function validDuelUpdate() {
      // Seule la map "runs" peut changer (ajout/mise à jour d'UN temps, jamais plus de 8
      // participants) ; le circuit et les réglages restent figés.
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['runs'])
        && request.resource.data.runs is map
        && request.resource.data.runs.size() <= 8
        && request.resource.data.runs.size() >= resource.data.runs.size();
    }
    function staleIncompleteDuel() {
      // Nettoyage automatique des défis jamais complétés (moins de 2 temps) après 48 h.
      return resource.data.runs.size() < 2
        && resource.data.createdAt is timestamp
        && request.time > resource.data.createdAt + duration.value(48, 'h');
    }
    match /duels/{id} {
      allow read: if true;
      allow create: if validDuelCreate(request.resource.data);
      allow update: if validDuelUpdate();
      allow delete: if staleIncompleteDuel();
    }
    match /public_duels/{id} {
      allow read: if true;
      allow create: if validDuelCreate(request.resource.data);
      allow update: if validDuelUpdate();
      allow delete: if staleIncompleteDuel();
    }

    // ---------- Anciennes collections v1 : figées (lecture seule) ----------
    match /races/{id} { allow read: if true; allow write: if false; }
    match /record_events/{id} { allow read: if true; allow write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
